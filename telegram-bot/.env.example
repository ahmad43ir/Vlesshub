# Telegram Bot (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Supabase (same as scraper — service_role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...your_service_role_key

# GitHub Actions — trigger scrape via workflow_dispatch (optional)
GITHUB_TOKEN=ghp_...your_personal_access_token
GITHUB_REPO=owner/repo
GITHUB_WORKFLOW=vless-scraper.yml

# Comma-separated Telegram user IDs authorized to manage the bot.
# Empty = anyone can use it.
AUTHORIZED_USERS=
